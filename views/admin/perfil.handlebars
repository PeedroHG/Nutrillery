{{>_navbar}}
{{>_msg}}

<style>
    .icon {
        width: 140px;
        height: 140px;
    }
</style>

{{#each perfil}}
<div class="container mt-4">

    <div class="">

        <div class="row">
            <h2 class="col-12">Perfil do Usuário</h2>
            <hr>
        </div>

        <div class="d-flex mt-4 justify-content-center">
            <div class="row col-3 ">
                <img src="../../public/img/perfil_img.png">
            </div>
        </div>

        <div class="row mt-1 d-flex justify-content-center">
            <div class="col-6 text-center">
                <h3>{{nome}}</h3>
            </div>
        </div>

        <div class="row mt-3 d-flex justify-content-center">
            <div class="col-6 text-center">
                <h5>{{email}}</h5>
            </div>
        </div>

        <div class="d-flex mt-5 justify-content-center">

            <div class="m-5">
                <a href="/admin/cadastroref">
                    <img src="../../public/img/icone_mais_verde.png" class="icon">
                </a>
            </div>

            <div class="m-5">
                <a href="/admin/calendario">
                    <img src="../../public/img/calendario_verde.png" class="icon">
                </a>
            </div>

        </div>



    </div>

</div>
{{/each}}